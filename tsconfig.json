{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": ["eslint.config.js", "tools/vite-config-base.ts", "tools/vite-plugin-monorepo.ts"],
  "exclude": ["node_modules", "dist"]
}
